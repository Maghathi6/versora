{
  "name": "versora-root",
  "version": "0.1.0",
  "private": true,
  "description": "Versora - Track what changed. Understand what it affects.",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"magenta,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend; npm run build:frontend",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "typecheck:frontend": "npm --prefix frontend run typecheck",
    "typecheck": "npm run typecheck:backend; npm run typecheck:frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
