# Versora Root Environment Configuration Template
# Copy this file to .env or configure respective frontend/.env and backend/.env

# Backend Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Future Database Configuration (Phase 2+)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/versora_dev

# Future Object Storage Configuration (Phase 12+)
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=your_access_key
# S3_SECRET_ACCESS_KEY=your_secret_key
# S3_BUCKET_NAME=versora-artifacts

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:4000/api
