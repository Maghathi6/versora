# Server Configuration
PORT=4000
NODE_ENV=development

# Security / CORS
CORS_ORIGIN=http://localhost:5173

# Authentication / JWT
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_EXPIRES_IN=15m

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/versora_dev

# Storage Configuration
STORAGE_ROOT=storage/artifacts
GIT_REPOS_ROOT=storage/repos
FRONTEND_URL=http://localhost:5173

# GitHub OAuth Integration (Optional for local development)
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/github/oauth/callback
# Dedicated 32-byte AES-256 key (e.g. 64 hex characters or 32 characters)
GITHUB_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# AI Project Assistant Configuration (Phase 4)
# Provider options: openai | anthropic | gemini | ollama (or mock for automated tests)
AI_PROVIDER=openai
# Server-side API Key (Keep secret! Never exposed to client bundles)
AI_API_KEY=sk-proj-your-api-key-here
# Optional model override (Defaults: gpt-4o-mini for openai, claude-3-5-sonnet-latest for anthropic, gemini-1.5-flash for gemini, llama3 for ollama)
AI_MODEL=gpt-4o-mini
# Optional base URL override (e.g. for Ollama: http://localhost:11434/v1 or custom OpenAI-compatible gateway)
# AI_BASE_URL=http://localhost:11434/v1

